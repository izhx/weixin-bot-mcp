# 复制为 .env 后自行编辑；不要覆盖已有 .env。实际 .env 设为 0600，不提交或分享。
# 普通部署用户的 UID/GID；按主机实际数值修改。
RUN_UID=1000
RUN_GID=1000

# 首次部署填写完整 Tunnel ID 和专用运行 Key；空值保留 data/ 中已有值。
# 建议用单引号包裹 Key，防止 $ 等字符被 Compose 插值。
WEIXIN_TUNNEL_ID=
WEIXIN_TUNNEL_RUNTIME_KEY=''

# 运行代理只允许 http://127.0.0.1:端口。
# 空值保留已有配置；明确填 direct 清除已保存代理、改为直连。
WEIXIN_TUNNEL_PROXY=
WEIXIN_CALLBACK_PROXY=
WEIXIN_MEDIA_PROXY=

# DNS 可填 system 或 google；空值保留已有配置，首次默认为 system。
WEIXIN_CALLBACK_DNS=
WEIXIN_MEDIA_DNS=

# 仅供 Docker Compose 构建参数使用，不会自动配置宿主下载脚本或运行代理。
BUILD_HTTP_PROXY=
